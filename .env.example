# ==============================================
# BUMDes BANYUBENING - Enterprise Environment
# ==============================================

# Database PostgreSQL (PRIMARY)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bumdes_banyubening?schema=public"

# Redis (Cache & Queue)
REDIS_URL="redis://localhost:6379"

# App
NODE_ENV="development"
PORT=4000
CORS_ORIGIN="http://localhost:3000,https://bumdes-banyubening.id"

# JWT - Access + Refresh
JWT_SECRET="super-secret-jwt-key-change-in-production-min-32-chars!!"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-production-32chars!!"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# PIN Authentication - Dual Layer (env + admin editable)
PIN_CODE="123456"
PIN_HASH=""

# Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880
STORAGE_PROVIDER="local"

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOG_LEVEL="info"

# WhatsApp API - Admin MUST configure
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""
WHATSAPP_NUMBER=""

# Backup & Disaster Recovery
BACKUP_DIR="./backups"
BACKUP_CRON="0 2 * * *"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
