# =============================================================================
# Automated Comic Translator - Backend environment template
# Copy to `.env` and adjust. All keys are optional (sane defaults exist).
#   cp .env.example .env
# =============================================================================

# --- Server -------------------------------------------------------------------
APP_NAME=Automated Comic Translator
VERSION=1.0.0
HOST=0.0.0.0
PORT=8000

# "*" opens CORS to every origin (dev). Pin to a comma-separated list for prod,
# e.g.  CORS_ORIGINS=chrome-extension://<YOUR_EXTENSION_ID>
CORS_ORIGINS=*
MAX_UPLOAD_MB=20

# --- Translation defaults ------------------------------------------------------
DEFAULT_SOURCE_LANG=auto
DEFAULT_TARGET_LANG=id            # id = Indonesian, en = English, ko = Korean...

# Failover chain: google -> mymemory -> libretranslate
TRANSLATOR_PRIMARY=google
TRANSLATOR_FALLBACKS=mymemory,libretranslate
LIBRETRANSLATE_URL=http://localhost:5000

# Batch all OCR lines into one request to dodge rate limits.
ENABLE_BATCH_TRANSLATION=true
BATCH_DELIMITER=-----

# --- OCR (PaddleOCR) -----------------------------------------------------------
# Script of the source text: japan | korean | ch | en
OCR_LANG=japan
USE_ANGLE_CLS=true               # detect rotated / vertical glyphs
OCR_THRESHOLD=0.5                # min recognition confidence

# --- Inpainting (LaMa) ---------------------------------------------------------
# Path to folder containing model weights (e.g. simple_lama / lama.onnx).
MODEL_DIR=./models
# Execution device: cpu | cuda | onnx
DEVICE=cpu
# Pixels of dilation around each OCR mask (covers old-text outlines).
MASK_DILATION=5
# Longest edge cap (px) before the pipeline; bigger images are downscaled.
MAX_IMAGE_SIZE=2000

# --- Rendering (Pillow) --------------------------------------------------------
# Path to a TrueType font (.ttf / .otf). Empty = auto-detect / PIL default.
FONT_PATH=
MIN_FONT_SIZE=10
MAX_FONT_SIZE=40
STROKE_RATIO=0.20
TEXT_FILL=#FFFFFF
STROKE_FILL=#000000
