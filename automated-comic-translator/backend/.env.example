# =============================================================================
# Automated Comic Translator - backend environment template
# Copy this file to `.env` and adjust as needed.
# If you use install.bat / install.ps1 / install.sh, this file is copied
# automatically when backend/.env does not exist yet.
# =============================================================================

# --- Server -----------------------------------------------------------------
APP_NAME=Automated Comic Translator
VERSION=1.0.0
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
# Use * for local development, or a comma-separated allow-list in production.
CORS_ORIGINS=*
MAX_UPLOAD_MB=20

# --- Translation -------------------------------------------------------------
DEFAULT_SOURCE_LANG=auto
DEFAULT_TARGET_LANG=id
TRANSLATOR_PRIMARY=google
TRANSLATOR_FALLBACKS=mymemory,libretranslate
LIBRETRANSLATE_URL=http://localhost:5000
ENABLE_BATCH_TRANSLATION=true
# Keep this rare so translators are unlikely to rewrite it.
BATCH_DELIMITER=\n-----\n
# --- OCR (PaddleOCR) ---------------------------------------------------------
# Common values: japan, korean, ch, en
OCR_LANG=japan
USE_ANGLE_CLS=true
OCR_THRESHOLD=0.5
OCR_DET_DB_THRESH=0.3
OCR_DET_DB_BOX_THRESH=0.6
OCR_DET_DB_UNCLIP_RATIO=1.5

# --- Inpainting (LaMa) -------------------------------------------------------
# Optional model folder for custom / exported weights.
MODEL_DIR=./models
# cpu | cuda | onnx
DEVICE=cpu
MASK_DILATION=5
MAX_IMAGE_SIZE=2000

# --- Rendering (Pillow) ------------------------------------------------------
# Optional TrueType/OpenType font path. Leave empty for auto-fallback.
FONT_PATH=
MIN_FONT_SIZE=10
MAX_FONT_SIZE=40
STROKE_RATIO=0.20
TEXT_FILL=#FFFFFF
STROKE_FILL=#000000
